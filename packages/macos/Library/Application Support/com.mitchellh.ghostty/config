font-family = "Hack"
confirm-close-surface = false
term = xterm-256color

# AstroDark theme colors
background = 1b1d22
foreground = adb0bb
cursor-color = 50a4e9
selection-background = 2e3440
selection-foreground = adb0bb

# Black (dimmed for subtle borders/UI)
palette = 0=1b1d22
palette = 8=3b4048

# Red (dimmed)
palette = 1=d56c75
palette = 9=ef6b73

# Green (dimmed)
palette = 2=7ecc7f
palette = 10=8df088

# Yellow (dimmed)
palette = 3=e0a980
palette = 11=f8bd96

# Blue (dimmed for subtle active borders)
palette = 4=4a8ac2
palette = 12=50a4e9

# Magenta (dimmed)
palette = 5=c17fd8
palette = 13=dd97f1

# Cyan (dimmed)
palette = 6=6bbfb0
palette = 14=7fdbca

# White (dimmed for less harsh text)
palette = 7=8c92a0
palette = 15=adb0bb

shell-integration = zsh

# Window navigation (sends Esc+H/L to tmux)
keybind = super+ctrl+h=text:\x1bH
keybind = super+ctrl+l=text:\x1bL

# History/list navigation: ctrl+j = Down, ctrl+k = Up
# Emitted as CSI arrow keys, so this works in the shell, tmux, and any TUI.
keybind = ctrl+j=csi:B
keybind = ctrl+k=csi:A

# Clear the terminal (scrollback included)
keybind = super+k=clear_screen

clipboard-read = allow
copy-on-select = false

# MacOS-specific settings
macos-non-native-fullscreen = visible-menu
macos-shortcuts = deny
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden
mouse-hide-while-typing = true
mouse-shift-capture = true
