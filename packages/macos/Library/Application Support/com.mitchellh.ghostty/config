font-family = "Hack"
confirm-close-surface = false

background = #1B1D22
theme = Aizen Dark
shell-integration = zsh

# Window navigation (sends Esc+H/L to tmux)
keybind = super+ctrl+h=text:\x1bH
keybind = super+ctrl+l=text:\x1bL

# History/list navigation: ctrl+j = Down, ctrl+k = Up
# Emitted as CSI arrow keys, so this works in the shell, tmux, and any TUI.
keybind = ctrl+j=csi:B
keybind = ctrl+k=csi:A

# Clear the terminal (scrollback included)
keybind = super+k=clear_screen

clipboard-read = allow
copy-on-select = false

# MacOS-specific settings
macos-non-native-fullscreen = visible-menu
macos-shortcuts = deny
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden
mouse-hide-while-typing = true
mouse-shift-capture = true
