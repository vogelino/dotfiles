#!/usr/bin/env python3
"""Review a Git branch with tuicr and carry review state across revisions."""

import argparse
import contextlib
import copy
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


def run(*args, optional=False, timeout=None):
    result = subprocess.run(args, text=True, capture_output=True, timeout=timeout)
    if result.returncode and not optional:
        raise RuntimeError(result.stderr.strip() or f"{args[0]} failed")
    return result.stdout.strip() if result.returncode == 0 else ""


def resolve_base(branch, explicit=None):
    base = explicit or run("git", "config", "--get", f"branch.{branch}.reviewBase", optional=True)
    if base:
        return base
    # A feature branch's upstream usually tracks itself, not its base.
    if shutil.which("gh"):
        try:
            base = run("gh", "pr", "view", branch, "--json", "baseRefName",
                       "--jq", ".baseRefName", optional=True, timeout=5)
        except subprocess.TimeoutExpired:
            base = ""
        if base:
            for ref in (f"refs/remotes/origin/{base}", f"refs/heads/{base}"):
                if run("git", "rev-parse", "--verify", f"{ref}^{{commit}}", optional=True):
                    return ref
            raise RuntimeError(f"PR base {base!r} is missing locally. Fetch it first.")
    for ref in ("refs/remotes/origin/main", "refs/remotes/origin/master",
                "refs/heads/main", "refs/heads/master"):
        if run("git", "rev-parse", "--verify", f"{ref}^{{commit}}", optional=True):
            return ref
    raise RuntimeError("Cannot find a base branch. Use --base <branch>.")


def read_json(path):
    return json.loads(Path(path).read_text())


def write_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(value, output, indent=2)
            output.write("\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def fnv1a(value):
    result = 0xcbf29ce484222325
    for byte in value.encode():
        result = ((result ^ byte) * 0x100000001b3) & 0xffffffffffffffff
    return f"{result:016x}"


@contextlib.contextmanager
def store_lock(directory):
    # Use tuicr 0.27's own lock protocol while updating its session and index.
    path = directory / ".tuicr.lock"
    deadline = time.monotonic() + 10
    while True:
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            if time.monotonic() >= deadline:
                raise RuntimeError("Tuicr's review store is busy. Try again later.")
            time.sleep(0.1)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(str(os.getpid()))
        yield
    finally:
        path.unlink()


def current_source(commits, head):
    if commits:
        return ("staged_unstaged_and_commits",
                f"staged-and-unstaged-and-commits/{commits[-1][:7]}..{commits[0][:7]}")
    return "working_tree", f"worktree/{head[:7]}"


def carry_state(pointer, root, branch, commits, head):
    previous = read_json(pointer)
    session_path = Path(previous["path"])
    if not session_path.exists():
        return
    directory = session_path.parent.parent
    with store_lock(directory):
        session = read_json(session_path)
        if Path(session["repo_path"]).resolve() != root or session.get("branch_name") != branch:
            raise RuntimeError("Saved review belongs to a different checkout or branch.")
        manifest = read_json(directory / "index.json")
        if manifest.get("version") != "2.0":
            raise RuntimeError("Unsupported tuicr review store format.")
        diff_source, source = current_source(commits, head)
        # The prefix came from tuicr, so forge names and branch sanitizing match.
        prefix = previous["slug"].split("@", 1)[0] + "@" + branch.replace("/", "-")
        slug = f"{prefix}/{source}"
        if slug == previous["slug"]:
            return
        entries = manifest["entries"].get(previous["slug"], [])
        entry = next((item for item in entries if item.get("canonical_repo_path") == str(root)), None)
        if entry is None:
            raise RuntimeError("Saved review is missing from tuicr's index.")
        session = copy.deepcopy(session)
        session["diff_source"] = diff_source
        session["commit_range"] = commits or None
        session["base_commit"] = commits[-1] if commits else head
        session["commit_selection_range"] = None
        session["updated_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        # Tuicr compares each saved content_hash with the new diff on startup.
        # Keep those hashes so changed files lose their reviewed mark.
        relative = f"sessions/{fnv1a(f'local|{slug}|{root}')}.json"
        write_json(directory / relative, session)
        entry = copy.deepcopy(entry)
        entry["path"] = relative
        entry["updated_at"] = session["updated_at"]
        bucket = manifest["entries"].setdefault(slug, [])
        bucket[:] = [item for item in bucket if item.get("canonical_repo_path") != str(root)]
        bucket.append(entry)
        write_json(directory / "index.json", manifest)


def remember_state(pointer, root, branch, commits, head):
    summaries = json.loads(run("tuicr", "review", "list", "--repo", str(root)))
    diff_source, _ = current_source(commits, head)
    matches = []
    for summary in summaries:
        if summary["kind"] != "local":
            continue
        session = read_json(summary["path"])
        if (Path(session["repo_path"]).resolve() == root
                and session.get("branch_name") == branch
                and session["diff_source"] == diff_source
                and (session.get("commit_range") or []) == commits
                and session["base_commit"] == (commits[-1] if commits else head)):
            matches.append(summary)
    if matches:
        latest = max(matches, key=lambda summary: summary["updated_at"])
        write_json(pointer, {"slug": latest["slug"], "path": latest["path"]})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", help="Override the PR base or default branch")
    parser.add_argument("--base-only", action="store_true", help="Print the base without opening tuicr")
    parser.add_argument("--reset", action="store_true", help="Forget carried state and use tuicr's current session")
    args = parser.parse_args()
    root = Path(run("git", "rev-parse", "--show-toplevel")).resolve()
    branch = run("git", "symbolic-ref", "--quiet", "--short", "HEAD", optional=True)
    if not branch:
        raise RuntimeError("Check out a branch first. Detached HEAD has no branch review state.")
    base = resolve_base(branch, args.base)
    run("git", "rev-parse", "--verify", f"{base}^{{commit}}")
    if args.base_only:
        print(base.removeprefix("refs/remotes/").removeprefix("refs/heads/"))
        return 0
    version = run("tuicr", "--version")
    if version != "tuicr 0.27.0":
        raise RuntimeError(f"State carry supports tuicr 0.27.0. Found {version}.")
    merge_base = run("git", "merge-base", base, "HEAD")
    head = run("git", "rev-parse", "HEAD")
    commits = run("git", "rev-list", "--topo-order", "--reverse", f"{merge_base}..{head}").splitlines()
    common = Path(run("git", "rev-parse", "--git-common-dir")).resolve()
    key = hashlib.sha256(f"{root}\0{branch}\0{base}".encode()).hexdigest()
    state_dir = common / "tuicr-review"
    state_dir.mkdir(parents=True, exist_ok=True)
    pointer = state_dir / f"{key}.json"
    with (state_dir / f"{key}.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("A review for this branch and base is already open.") from None
        summaries = json.loads(run("tuicr", "review", "list", "--repo", str(root)))
        if any(item["active"] and item["kind"] == "local" for item in summaries):
            raise RuntimeError("Close the existing local tuicr review first.")
        if args.reset and pointer.exists():
            pointer.unlink()
        if pointer.exists():
            carry_state(pointer, root, branch, commits, head)
        command = ["tuicr", "--working-tree"]
        if commits:
            command.extend(["--revisions", f"{merge_base}..{head}"])
        print(f"Reviewing {branch} against {base} (including uncommitted changes).", file=sys.stderr)
        result = subprocess.run(command)
        remember_state(pointer, root, branch, commits, head)
        return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError, KeyError) as error:
        print(f"git-review: {error}", file=sys.stderr)
        sys.exit(1)
